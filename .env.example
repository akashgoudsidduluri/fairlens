# ========================================================
# FairLens India - Environment Configuration Reference
# ========================================================

# 1. Render Backend (Web Service)
PORT=8020
FAIRLENS_SERVICE_HOST=0.0.0.0
PYTHONPATH=.

# 2. Vercel Frontend (Configure in Vercel Project Settings)
# Point this to your live Render backend URL
VITE_API_BASE=https://fairlens-backend.onrender.com

# 3. Optional LLM Target Screener (Anthropic API Key)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
